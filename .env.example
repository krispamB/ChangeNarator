# GitHub Personal Access Token (required for PR fetching)
# Create one at: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos only)
GITHUB_TOKEN=your_github_token_here

# AI provider credentials (only the selected API provider is required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# WatsonX Configuration
# Get your credentials from IBM Cloud: https://cloud.ibm.com/
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

NOTION_TOKEN=xxx
NOTION_PARENT_PAGE_ID=xxx  # the page you share with your integration
