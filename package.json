{
  "name": "changenarrator",
  "version": "1.0.11",
  "description": "An AI-powered tool that watches code changes and automatically generates human-readable changelogs from GitHub PRs",
  "keywords": [
    "changelog",
    "github",
    "pull-request",
    "ai",
    "watsonx",
    "notion",
    "release-notes",
    "documentation",
    "automation",
    "cli"
  ],
  "author": "Bob",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krispamB/ChangeNarator.git"
  },
  "homepage": "https://github.com/krispamB/ChangeNarator#readme",
  "bugs": {
    "url": "https://github.com/krispamB/ChangeNarator/issues"
  },
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "changenarrator": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target node",
    "build:cli": "bun build src/cli/index.ts --outdir ./dist/cli --target node && cp -r src/prompts dist/",
    "cli": "bun run src/cli/index.ts",
    "prepublishOnly": "bun run build:cli",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.8.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@notionhq/client": "^5.21.0",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^17.4.2"
  }
}
